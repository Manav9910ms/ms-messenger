rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCallParticipant(callData) {
      return signedIn() &&
        (callData.fromUid == request.auth.uid || callData.toUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.username is string;
      allow update: if isUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.username == resource.data.username;
      allow delete: if isUser(userId);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.receiverUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.text is string;

      allow update: if signedIn()
        && resource.data.receiverUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.text == resource.data.text
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);

      allow delete: if signedIn()
        && resource.data.senderUid == request.auth.uid;
    }

    match /calls/{callId} {
      allow read: if signedIn() && isCallParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string;

      allow update: if signedIn()
        && isCallParticipant(resource.data)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, write: if signedIn()
          && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
    }
  }
}
